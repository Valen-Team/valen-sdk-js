{
  "name": "@valen-team/sdk",
  "version": "0.2.1",
  "description": "Valen decision SDK for HTTP and local ONNX inference",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "LICENSE",
    "PILLOW-LICENSE.txt",
    "README.md",
    "README_zh.md",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "examples",
    "assets/branding",
    "CHANGELOG.md",
    "RELEASING.md",
    "contracts"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit --allowJs --checkJs false --module nodenext --target es2022 src/index.d.ts test-d/types.ts --types node",
    "test:package": "node --experimental-vm-modules scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "4.3.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "typescript": "^5.9.0",
    "@types/node": "26.6.5",
    "mediabunny": "1.62.1"
  },
  "peerDependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "mediabunny": "1.62.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@huggingface/tokenizers": {
      "optional": true
    },
    "@huggingface/jinja": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    },
    "mediabunny": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valen-Team/valen-sdk-js.git"
  },
  "homepage": "https://github.com/Valen-Team/valen-sdk-js#readme",
  "publishConfig": {
    "access": "public"
  }
}
